# URL base da API Express (somente a URL: NUNCA coloque tokens, senhas ou chaves em variáveis VITE_, elas vão para o navegador)
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Timeout das requisições (ms)
VITE_API_TIMEOUT_MS=30000
# Atualização automática (ms). 0 desliga.
VITE_REFRESH_KPI_MS=0
VITE_REFRESH_STATUS_MS=30000
# Critério financeiro padrão: MOVIMENTACAO | APROVADAS (APROVADAS aproxima o painel Pagah)
VITE_DEFAULT_CRITERIO=MOVIMENTACAO
# Dados são exibidos como "desatualizados" após N segundos sem sincronização (o backend também informa)
VITE_STALE_AFTER_SECONDS=300
